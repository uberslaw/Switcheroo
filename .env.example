# Switcheroo configuration
# Copy this file to .env and adjust. Lab defaults are NOT production-safe.
# Never commit .env or device/TACACS passwords.

# --- Driver ---
# simulator (default): in-process fake Catalyst 9300s, no hardware required.
# cisco_iosxe: RESTCONF/NETCONF/SSH/SNMP against real boxes. A switch without
# credentials still stays on the simulator so a missing secret cannot take the
# site down.
SWITCHEROO_DRIVER=simulator

# --- Bind address ---
# Default is loopback for a safe first run on this machine.
# To expose on the internal LAN, set SWITCHEROO_HOST=0.0.0.0 and restrict
# with host firewall / reverse proxy. Do not put this on the public internet.
SWITCHEROO_HOST=127.0.0.1
SWITCHEROO_PORT=8080

# Session signing key. Change before any shared/internal deploy.
SWITCHEROO_SECRET_KEY=change-me-lab-only-not-for-production

# --- Paths (relative to the project root unless absolute) ---
SWITCHEROO_DATA_DIR=data
# Leave empty to use <data dir>/switcheroo.db
SWITCHEROO_DATABASE_URL=
SWITCHEROO_LOG_FILE=data/switcheroo.log

# --- Polling (must stay gentle on Catalyst 9300s) ---
# Targeted ifOperStatus only. Allowed range 60-180 seconds.
SWITCHEROO_STATUS_POLL_INTERVAL=60
# Shared per-port cooldown for on-demand VLAN/MAC/IP/ISE refresh.
SWITCHEROO_ON_DEMAND_COOLDOWN=60
# Troubleshooting: one port, one user, then auto-stop.
SWITCHEROO_TROUBLESHOOT_INTERVAL=10
SWITCHEROO_TROUBLESHOOT_DURATION=300
# Hour (0-23, UTC) for the daily VLAN/MAC/IP/ISE sweep.
SWITCHEROO_DAILY_POLL_HOUR=2
# Simulator only: occasional link flaps so the UI looks alive. Set 0 in tests.
SWITCHEROO_SIM_FLAPS=1

# --- ServiceNow VLAN-change POC (Table API) ---
# Default: no live HTTP. Dry-run writes payload files under data/servicenow-dryrun/.
# Live mode requires ENABLED=true, DRY_RUN=false, and a dedicated integration user.
# See docs/servicenow-poc.md for the IAM / ServiceNow brief.
SERVICENOW_ENABLED=false
SERVICENOW_DRY_RUN=true
SERVICENOW_INSTANCE=https://arup.service-now.com
SERVICENOW_TABLE=incident
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_POLL_SECONDS=120
# Live Table API only. Dry-run never opens a socket. Keep this short.
SERVICENOW_HTTP_TIMEOUT=10
# Out-of-box incident states — confirm with Arup SN before going live.
SERVICENOW_STATE_RESOLVED=6
SERVICENOW_STATE_CANCELLED=8
SERVICENOW_CLOSE_CODE=Solved (Permanently)

# --- Optional Cisco path (ignored while SWITCHEROO_DRIVER=simulator) ---
# Use a dedicated TACACS or local read/write user. Do not reuse personal logins.
CISCO_RESTCONF_PORT=443
CISCO_RESTCONF_VERIFY_TLS=true
CISCO_NETCONF_PORT=830
CISCO_SSH_PORT=22
# Leave community empty unless you intentionally enable SNMP ifOperStatus polls.
CISCO_SNMP_COMMUNITY=
CISCO_SNMP_PORT=161
CISCO_CONNECT_TIMEOUT=10
